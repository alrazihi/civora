# CIVORA environment configuration
# Copy to .env and adjust as needed

# Server
CIVORA_SERVER_PORT=8080
CIVORA_SERVER_READ_TIMEOUT=30s
CIVORA_SERVER_WRITE_TIMEOUT=30s
CIVORA_SERVER_IDLE_TIMEOUT=120s

# Database
CIVORA_DB_DRIVER=pgx
CIVORA_DB_HOST=localhost
CIVORA_DB_PORT=5432
CIVORA_DB_USER=civora_test
CIVORA_DB_PASSWORD=civora_test
CIVORA_DB_NAME=civora_test
CIVORA_DB_SSLMODE=disable

# Authentication
CIVORA_AUTH_JWT_SECRET=change-me-to-a-long-random-secret-key-32+chars
CIVORA_AUTH_JWT_EXPIRY=24h
CIVORA_AUTH_BCRYPT_COST=12
