# CIVORA environment configuration
# Copy to .env and adjust as needed

# Server
CIVORA_SERVER_PORT=8080
CIVORA_SERVER_READ_TIMEOUT=30s
CIVORA_SERVER_WRITE_TIMEOUT=30s
CIVORA_SERVER_IDLE_TIMEOUT=120s

# Database
CIVORA_DB_DRIVER=pgx
CIVORA_DB_HOST=localhost
CIVORA_DB_PORT=5432
CIVORA_DB_USER=civora
CIVORA_DB_PASSWORD=civora
CIVORA_DB_NAME=civora
CIVORA_DB_SSLMODE=disable

# Authentication
CIVORA_AUTH_JWT_SECRET=dev-secret-change-me-32-chars-minimum
CIVORA_AUTH_JWT_EXPIRY=24h
CIVORA_AUTH_BCRYPT_COST=12

# OIDC (optional - leave empty for local auth)
CIVORA_AUTH_OIDC_ISSUER=
CIVORA_AUTH_OIDC_CLIENT_ID=
CIVORA_AUTH_OIDC_REDIRECT_URL=

# Audit
CIVORA_AUDIT_ENABLED=true
CIVORA_AUDIT_HASH_CHAIN=true
CIVORA_AUDIT_RETENTION_DAYS=2555
